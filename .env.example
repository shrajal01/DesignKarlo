# ========================================================
# DesignKarlo - Environment Variables Template
# Copy this file to .env in local environments:
#   cp .env.example .env
# ========================================================

# API Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Client Configuration
CLIENT_URL=http://localhost:5173

# Database (Optional for Phase 1 foundation; MongoDB connection will not block server startup)
MONGODB_URI=mongodb://localhost:27017/designkarlo

# Frontend API Target (for Netlify/production builds, set to https://designkarlo-api.onrender.com; leave empty in dev)
VITE_API_URL=
